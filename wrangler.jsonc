{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "file-uploader-demo",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-28",
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "file-uploader-demo", "database_id": "a5987b22-0ad5-4813-9b4c-55132f580912", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "file-uploader-demo" }]
}
